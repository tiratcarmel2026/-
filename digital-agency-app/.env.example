# --- חובה: מפתח Anthropic (Claude) ליצירת התוכן ---
ANTHROPIC_API_KEY=

# מודל Claude לשימוש ליצירת תוכן (ברירת מחדל: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# --- אופציונלי: פייסבוק/אינסטגרם (Meta Graph API) ---
# בלי אלה המערכת עובדת במצב דמו (mock) עם נתוני דוגמה בלבד,
# ולא סורקת רשתות אמיתיות. ראו README.md להוראות קבלת טוקן.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- הגדרות שרת ---
PORT=3000
TZ=Asia/Jerusalem

# האם להריץ יצירת תוכן מיד עם עליית השרת (בנוסף לריצה השעתית)
RUN_ON_STARTUP=false
